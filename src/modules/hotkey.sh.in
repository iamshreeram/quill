#!/bin/sh
# Auto-generated by `quill setup`; re-run it to regenerate.
umask 077
LOG=@LOG@
CONFDIR=$(dirname "$LOG")
LOCKFILE="$CONFDIR/.hotkey.lock"

# Notification text is passed as an osascript argument (data), never spliced into AppleScript.
# fd 9 (the single-instance lock) is closed here: notification helpers must never keep the lock.
notify() {
  osascript @NOTIFY_ARGS@ -- "$1" >/dev/null 2>&1 9>&-
}

# ---- single instance (kernel flock on fd 9; released by the kernel when the last process
# holding the open file description exits, so there is no stale state to recover) ----
if [ -L "$LOCKFILE" ] || { [ -e "$LOCKFILE" ] && [ ! -f "$LOCKFILE" ]; }; then
  notify "Quill: the lock file is a symlink or not a regular file: $LOCKFILE. Remove it and try again."
  exit 1
fi
LOCKING=1
command -v perl >/dev/null 2>&1 || LOCKING=0
if [ "$LOCKING" = 1 ] && ! ( : 9>>"$LOCKFILE" ) 2>/dev/null; then
  LOCKING=0
fi
if [ "$LOCKING" = 1 ]; then
  exec 9>>"$LOCKFILE"
  perl -e 'use Fcntl qw(:flock); open(my $fh, ">&=", 9) or exit 2; exit(flock($fh, LOCK_EX | LOCK_NB) ? 0 : 1)'
  case $? in
    0) ;;
    1) exit 0 ;;
    *) LOCKING=0 ;;
  esac
fi

# ---- log safety ----
if [ -L "$LOG" ] || { [ -e "$LOG" ] && [ ! -f "$LOG" ]; }; then
  notify "Quill: the log file is a symlink or not a regular file: $LOG. Remove it and run quill setup again."
  exit 1
fi
if [ -e "$LOG" ]; then
  chmod 600 "$LOG" 2>/dev/null || {
    notify "Quill: cannot restrict the permissions of $LOG. Fix them and try again."
    exit 1
  }
fi
RUNLOG=$(mktemp "$CONFDIR/.hotkey.XXXXXX") || {
  notify "Quill: cannot create a temporary file in $CONFDIR."
  exit 1
}
TRIM=
trap 'rm -f "$RUNLOG" "$TRIM" 2>/dev/null' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

# append_run RC: appends one block (header + this run's stderr) to the log; returns 1 on failure.
append_run() {
  {
    printf '%s run pid=%s rc=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$$" "$1"
    if [ "$LOCKING" = 0 ]; then
      printf '%s\n' '[quill] warning: single-instance lock unavailable'
    fi
    cat "$RUNLOG"
  } 2>/dev/null >> "$LOG"
}

# trim_log: keeps the log below roughly 100 KB (last 400 lines); any failure just skips the trim.
trim_log() {
  size=$(wc -c < "$LOG" 2>/dev/null | tr -d ' ')
  [ -n "$size" ] && [ "$size" -gt 100000 ] || return 0
  TRIM=$(mktemp "$CONFDIR/.hotkey.XXXXXX") || { TRIM=; return 0; }
  if tail -n 400 "$LOG" > "$TRIM" 2>/dev/null && mv "$TRIM" "$LOG" 2>/dev/null; then
    TRIM=
  else
    rm -f "$TRIM"
    TRIM=
  fi
  return 0
}

finish_log() {
  append_run "$1" || return 1
  trim_log
  return 0
}

# stop_with MSG: permission problem; log it, tell the user, and do NOT run quill.
stop_with() {
  printf '%s\n' "[quill] $1" > "$RUNLOG"
  if finish_log 1; then
    notify "$1"
  else
    notify "Quill: cannot write $LOG (check permissions). $1"
  fi
  exit 1
}

# Copies the selected text via Edit > Copy of the frontmost app, then transforms it.
# (Keeps fd 9: the copy and quill are the processes that touch the clipboard.)
out=$(osascript @COPY_ARGS@ 2>&1)
case "$out" in
  *-1743*|*"Not authorized to send Apple events"*) stop_with @MSG_AUTOMATION@ ;;
  *-25211*) stop_with @MSG_ACCESSIBILITY@ ;;
  *-1719*assistive*|*assistive*-1719*) stop_with @MSG_ACCESSIBILITY@ ;;
  *-1728*) ;;
  *-1719*"Invalid index"*|*"Invalid index"*-1719*|*-1719*"Can't get"*|*"Can't get"*-1719*) ;;
  *-1719*) stop_with @MSG_COPY_FAILED@ ;;
esac
sleep 0.1
if @BIN@ --now 2>"$RUNLOG"; then rc=0; else rc=$?; fi

is_line() { grep -F -x -q -- "$1" "$RUNLOG"; }
if [ "$rc" -ne 0 ]; then
  last=$(grep -v '^[[:space:]]*$' "$RUNLOG" | tail -n 1 | sed 's/^\[quill\] //' | cut -c1-160)
  if [ -n "$last" ]; then
    BANNER="Quill failed: $last. See ~/.config/quill/quill.log"
  else
    BANNER="Quill failed (exit $rc). See ~/.config/quill/quill.log"
  fi
elif grep -q '^\[quill\] AI request failed (.*); falling back to offline grammar mode\.$' "$RUNLOG"; then
  reason=$(sed -n 's/^\[quill\] AI request failed (\(.*\)); falling back to offline grammar mode\.$/\1/p' "$RUNLOG" | head -n 1 | cut -c1-120)
  [ -n "$reason" ] || reason="reason unknown"
  if is_line '[quill] no changes'; then
    BANNER="Quill: AI failed ($reason). Offline grammar found nothing to fix; clipboard left as is."
  else
    BANNER="Quill: AI failed ($reason); used offline grammar fixes. Result is on the clipboard - paste with Cmd+V."
  fi
elif is_line '[quill] no changes'; then
  BANNER="Quill: no changes found; clipboard left as is."
elif is_line '[quill] done (offline grammar mode)'; then
  BANNER="Quill: offline grammar fixes applied. Result is on the clipboard - paste with Cmd+V."
elif is_line '[quill] done'; then
  BANNER="Quill: result is on the clipboard - paste with Cmd+V."
else
  BANNER="Quill: finished. See ~/.config/quill/quill.log"
fi

LOGFAIL=0
if ! finish_log "$rc"; then
  LOGFAIL=1
  BANNER="Quill: cannot write $LOG (check permissions). $BANNER"
fi
notify "$BANNER"
exit "$LOGFAIL"
